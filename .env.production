# PostHog browser analytics.
#
# Committed on purpose: the project token is public by design — it ships in
# the JS bundle — and production builds must never lack it (next.config.ts
# fails the build if it is missing). Loaded by `next build` only. `next dev`
# runs with analytics off unless .env.local sets these (see .env.example).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_mi6LQRVP7QkPGRuN8SyLk4EFbTECw3fFJHhQZUACtjvt
NEXT_PUBLIC_POSTHOG_HOST=https://r.valorantpicker.com
