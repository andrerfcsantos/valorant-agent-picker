# https://developers.cloudflare.com/workers/static-assets/headers
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Next's metadata image routes emit extensionless files, so static-asset
# serving can't infer their MIME type. Set it explicitly or social scrapers
# reject the image.
/opengraph-image
  Content-Type: image/png

/share/agent/opengraph-image
  Content-Type: image/png

/share/squad/opengraph-image
  Content-Type: image/png
