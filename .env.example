# PostHog browser analytics. Optional in development: without both values
# the site runs with analytics off. Copy these into .env.local to send dev
# events (they are flagged as internal traffic, and dev sessions are never
# recorded).
#
# NEXT_PUBLIC_POSTHOG_HOST is the first-party reverse proxy
# (https://r.valorantpicker.com, a CNAME to PostHog's managed proxy) rather
# than https://us.i.posthog.com, so ad blockers don't recognize the requests.
# The region-specific UI host is hardcoded in src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://r.valorantpicker.com

# Which design a visitor gets before they have chosen one: `classic` (the
# default) or `refresh` (the new design). Visitors can switch either way from
# the navbar, and their choice wins over this. Flip it to make the new design
# the default without a code change.
# NEXT_PUBLIC_DEFAULT_DESIGN=refresh
